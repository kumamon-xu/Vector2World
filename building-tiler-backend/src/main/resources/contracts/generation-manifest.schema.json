{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vector2world.local/contracts/generation-manifest.schema.json",
  "title": "Vector2World generation manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "applicationVersion", "applicationBuildNumber", "applicationGitSha",
    "applicationGitDirty", "applicationBuildTime", "osm2worldVersion", "osm2worldCommit",
    "ruleVersion", "presetVersion", "configHash", "sourceFormat", "sourceCrs", "crsSource",
    "heightMapping", "zoom", "lods", "outputFormats", "crossTileStrategy",
    "crossTileBufferMeters", "boundsWgs84", "ownershipHash", "tileContents",
    "modelingLedger", "incomplete", "failedBuildings", "deliveryPolicy", "buildTime"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "applicationVersion": { "type": "string", "minLength": 1 },
    "applicationBuildNumber": { "type": "string", "minLength": 1 },
    "applicationGitSha": { "type": "string", "minLength": 7 },
    "applicationGitDirty": { "type": "boolean" },
    "applicationBuildTime": { "type": "string", "minLength": 1 },
    "osm2worldVersion": { "type": "string", "minLength": 1 },
    "osm2worldCommit": { "type": "string", "minLength": 7 },
    "ruleVersion": { "const": "m2-rules-v1" },
    "presetVersion": { "type": "string", "minLength": 1 },
    "styleBundleVersion": { "type": "string", "minLength": 1 },
    "styleBundleSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "configHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "sourceFormat": { "enum": ["GEOJSON", "SHP"] },
    "sourceCrs": { "type": "string", "minLength": 1 },
    "crsSource": { "enum": ["DECLARED_VALID", "EXPLICIT_OVERRIDE"] },
    "sourceEncoding": { "type": "string" },
    "archiveEntryEncoding": { "type": ["string", "null"] },
    "archiveEntryEncodingFallback": { "type": "boolean" },
    "heightMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fieldName", "unit", "invalidPolicy", "maximumHeightMeters"],
      "properties": {
        "fieldName": { "type": "string", "minLength": 1 },
        "unit": { "enum": ["m", "cm", "mm", "ft"] },
        "invalidPolicy": { "enum": ["SKIP", "FAIL"] },
        "maximumHeightMeters": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "zoom": { "type": "integer", "minimum": 0, "maximum": 22, "default": 15 },
    "lods": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "enum": [2, 3, 4] } },
    "outputFormats": {
      "type": "array",
      "prefixItems": [{ "const": "3DTILES" }],
      "items": false
    },
    "crossTileStrategy": { "const": "centroid-owner/full-footprint/no-clip" },
    "crossTileBufferMeters": { "const": 0 },
    "boundsWgs84": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": { "type": "number" }
    },
    "ownershipHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "tileContents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tile", "lod", "tilesetPath", "glbPath"],
        "properties": {
          "tile": { "type": "string" },
          "lod": { "enum": [2, 3, 4] },
          "tilesetPath": { "type": "string", "pattern": "^[^\\\\]*\\.tileset\\.json$" },
          "glbPath": { "type": "string", "pattern": "^[^\\\\]*\\.glb$" }
        }
      }
    },
    "modelingLedger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "inputParts", "modeledParts", "missingUnattributed", "statusCounts"],
      "properties": {
        "path": { "const": "modeling-ledger.json" },
        "inputParts": { "type": "integer", "minimum": 0 },
        "modeledParts": { "type": "integer", "minimum": 0 },
        "missingUnattributed": { "type": "integer", "minimum": 0 },
        "statusCounts": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } }
      }
    },
    "incomplete": { "type": "boolean" },
    "failedBuildings": { "type": "integer", "minimum": 0 },
    "deliveryPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowPartialResult", "maxFailedTiles", "maxFailedTileRatio", "maxFailedBuildings", "maxFailedBuildingRatio"],
      "properties": {
        "allowPartialResult": { "type": "boolean" },
        "maxFailedTiles": { "type": "integer", "minimum": 0 },
        "maxFailedTileRatio": { "type": "number", "minimum": 0, "maximum": 1 },
        "maxFailedBuildings": { "type": "integer", "minimum": 0 },
        "maxFailedBuildingRatio": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "buildTime": { "type": "string", "format": "date-time" }
  }
}
