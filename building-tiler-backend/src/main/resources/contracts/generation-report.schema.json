{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vector2world.local/contracts/generation-report.schema.json",
  "title": "Vector2World generation report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "jobId", "state", "buildStarted", "buildFinished", "elapsedMillis",
    "inputFeatures", "validBuildings", "skippedInvalidHeight", "skippedInvalidGeometry",
    "plannedTiles", "successfulTiles", "failedTiles", "incomplete", "failedBuildings", "deliveryPolicy", "successfulTileContents",
    "modeledBuildings", "meshCount", "vertexCount", "triangleCount", "crossTileBuildings",
    "largeBuildings", "ownershipHash", "configHash", "contentBytes", "outputBytes",
    "quantization", "tileResults", "tileFailures", "warnings", "validation", "resourceMetrics", "volatileFields"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "jobId": { "type": "string", "format": "uuid" },
    "state": { "enum": ["COMPLETED", "COMPLETED_WITH_WARNINGS"] },
    "buildStarted": { "type": "string", "format": "date-time" },
    "buildFinished": { "type": "string", "format": "date-time" },
    "elapsedMillis": { "$ref": "#/$defs/nonNegativeInteger" },
    "inputFeatures": { "$ref": "#/$defs/nonNegativeInteger" },
    "validBuildings": { "$ref": "#/$defs/nonNegativeInteger" },
    "skippedInvalidHeight": { "$ref": "#/$defs/nonNegativeInteger" },
    "skippedInvalidGeometry": { "$ref": "#/$defs/nonNegativeInteger" },
    "plannedTiles": { "$ref": "#/$defs/nonNegativeInteger" },
    "successfulTiles": { "$ref": "#/$defs/nonNegativeInteger" },
    "failedTiles": { "$ref": "#/$defs/nonNegativeInteger" },
    "incomplete": { "type": "boolean" },
    "failedBuildings": { "$ref": "#/$defs/nonNegativeInteger" },
    "deliveryPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowPartialResult", "maxFailedTiles", "maxFailedTileRatio", "maxFailedBuildings", "maxFailedBuildingRatio"],
      "properties": {
        "allowPartialResult": { "type": "boolean" },
        "maxFailedTiles": { "$ref": "#/$defs/nonNegativeInteger" },
        "maxFailedTileRatio": { "type": "number", "minimum": 0, "maximum": 1 },
        "maxFailedBuildings": { "$ref": "#/$defs/nonNegativeInteger" },
        "maxFailedBuildingRatio": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "successfulTileContents": { "$ref": "#/$defs/nonNegativeInteger" },
    "modeledBuildings": { "$ref": "#/$defs/nonNegativeInteger" },
    "meshCount": { "$ref": "#/$defs/nonNegativeInteger" },
    "vertexCount": { "$ref": "#/$defs/nonNegativeInteger" },
    "triangleCount": { "$ref": "#/$defs/nonNegativeInteger" },
    "crossTileBuildings": { "$ref": "#/$defs/nonNegativeInteger" },
    "largeBuildings": { "$ref": "#/$defs/nonNegativeInteger" },
    "ownershipHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "configHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "contentBytes": { "$ref": "#/$defs/nonNegativeInteger" },
    "outputBytes": { "$ref": "#/$defs/nonNegativeInteger" },
    "quantization": { "enum": ["KHR_mesh_quantization", "NOT_EMITTED_BY_LOCKED_UPSTREAM"] },
    "tileResults": { "type": "array", "items": { "type": "object" } },
    "tileFailures": { "type": "array", "items": { "type": "object" } },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "validation": {
      "type": "object",
      "required": ["valid", "assetVersion", "tilesetCount", "glbCount", "errors", "extensionsUsed"],
      "properties": {
        "valid": { "const": true },
        "assetVersion": { "const": "1.1" },
        "tilesetCount": { "$ref": "#/$defs/nonNegativeInteger" },
        "glbCount": { "$ref": "#/$defs/nonNegativeInteger" },
        "errors": { "type": "array", "maxItems": 0 },
        "extensionsUsed": { "type": "array", "items": { "type": "string" } }
      }
    },
    "resourceMetrics": {
      "type": "object",
      "required": ["phaseNanos", "peakHeapBytes", "gcCollections", "gcTimeMillis", "emittedTileBytes", "retryAttempts", "effectiveWorkers", "maxQueuedTiles", "maxRunningTiles", "maxInFlightTiles", "maxGlobalQueueDepth", "tileWaitNanos", "tileExecutionNanos", "startedTiles"],
      "properties": {
        "phaseNanos": { "type": "object", "additionalProperties": { "$ref": "#/$defs/nonNegativeInteger" } },
        "peakHeapBytes": { "$ref": "#/$defs/nonNegativeInteger" },
        "gcCollections": { "$ref": "#/$defs/nonNegativeInteger" },
        "gcTimeMillis": { "$ref": "#/$defs/nonNegativeInteger" },
        "emittedTileBytes": { "$ref": "#/$defs/nonNegativeInteger" },
        "retryAttempts": { "$ref": "#/$defs/nonNegativeInteger" },
        "effectiveWorkers": { "type": "integer", "minimum": 1 },
        "maxQueuedTiles": { "$ref": "#/$defs/nonNegativeInteger" },
        "maxRunningTiles": { "$ref": "#/$defs/nonNegativeInteger" },
        "maxInFlightTiles": { "$ref": "#/$defs/nonNegativeInteger" },
        "maxGlobalQueueDepth": { "$ref": "#/$defs/nonNegativeInteger" },
        "tileWaitNanos": { "$ref": "#/$defs/nonNegativeInteger" },
        "tileExecutionNanos": { "$ref": "#/$defs/nonNegativeInteger" },
        "startedTiles": { "$ref": "#/$defs/nonNegativeInteger" }
      }
    },
    "volatileFields": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "nonNegativeInteger": { "type": "integer", "minimum": 0 }
  }
}
